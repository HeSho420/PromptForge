@echo off
rem PromptForge bootstrap - double-click after downloading from GitHub and
rem everything else happens by itself:
rem   * run inside an unpacked Download-ZIP folder: connects the folder to
rem     the update channel and starts the app
rem   * run as a lone file: installs git if needed - winget first, then a
rem     direct Portable Git download for machines without winget - clones
rem     PromptForge to %%USERPROFILE%%\PromptForge and starts the app
rem Plain cmd + per-process ExecutionPolicy Bypass: works on every PC,
rem including ones where running PowerShell scripts is disabled by default.
rem The PF_ENSURE_GIT blob is the base64/UTF-16 encoding of a small
rem PowerShell routine - cleartext kept at installer\ensure-git.ps1 in the
rem repository - that prints the path of a working git.exe, installing one
rem when needed. Encoded so cmd quoting rules cannot corrupt it.
setlocal EnableExtensions
title PromptForge
cd /d "%~dp0"

if not exist "%~dp0launch.ps1" goto :bootstrap
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0installer\bootstrap.ps1"
if errorlevel 1 pause
exit /b 0

:bootstrap
echo   == PromptForge bootstrap ==
echo   Checking git - installing it first when missing, please wait...
set "PF_GIT="
set "PF_ENSURE_"
for /f "usebackq delims=" %%G in (`powershell -NoProfile -EncodedCommand %PF_ENSURE_GIT%`) do set "PF_GIT=%%G"
if not defined PF_GIT goto :nogit
if not exist "%PF_GIT%" goto :nogit

set "PF_DEST=%USERPROFILE%\PromptForge"
if exist "%PF_DEST%\launch.ps1" goto :launch
if exist "%PF_DEST%" ren "%PF_DEST%" "PromptForge.old-%RANDOM%"
echo   Downloading PromptForge...
"%PF_GIT%" -c http.sslBackend=schannel clone https://github.com/HeSho420/PromptForge.git "%PF_DEST%"
if errorlevel 1 goto :clonefail

:launch
cd /d "%PF_DEST%"
powershell -NoProfile -ExecutionPolicy Bypass -File "%PF_DEST%\launch.ps1"
if errorlevel 1 pause
exit /b 0

:nogit
echo   git could not be installed automatically - no winget and the direct
echo   download failed. Install git from git-scm.com and run this again.
pause
exit /b 1

:clonefail
echo   Could not download PromptForge. Check the internet connection and that
echo   this Windows account has access to the repository, then retry.
pause
exit /b 1