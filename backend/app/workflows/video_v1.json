{
  "template": "video",
  "version": 1,
  "description": "WAN 2.2 TI2V-5B image-to-video (ComfyUI native nodes). Sized for 8 GB VRAM: fp16 5B model with RAM offload, 640x640 default, 49 frames @ 24 fps. Output is an animated WEBP.",
  "required_models": [
    "wan22-ti2v-5b",
    "wan-umt5-xxl",
    "wan22-vae"
  ],
  "parameters": {
    "prompt": {
      "node": "4",
      "input": "text"
    },
    "negative_prompt": {
      "node": "5",
      "input": "text"
    },
    "image": {
      "node": "6",
      "input": "image"
    },
    "seed": {
      "node": "9",
      "input": "seed"
    },
    "width": {
      "node": "7",
      "input": "width"
    },
    "height": {
      "node": "7",
      "input": "height"
    },
    "length": {
      "node": "7",
      "input": "length"
    },
    "steps": {
      "node": "9",
      "input": "steps"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "wan2.2_ti2v_5B_fp16.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "type": "wan",
        "device": "default"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "wan2.2_vae.safetensors"
      }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": ["2", 0]
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, distorted, glitch, flicker, watermark, text, static, frozen",
        "clip": ["2", 0]
      }
    },
    "6": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "7": {
      "class_type": "WanImageToVideo",
      "inputs": {
        "width": 640,
        "height": 640,
        "length": 49,
        "batch_size": 1,
        "positive": ["4", 0],
        "negative": ["5", 0],
        "vae": ["3", 0],
        "start_image": ["6", 0]
      }
    },
    "8": {
      "class_type": "ModelSamplingSD3",
      "inputs": {
        "model": ["1", 0],
        "shift": 8.0
      }
    },
    "9": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 20,
        "cfg": 5.0,
        "sampler_name": "uni_pc",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": ["8", 0],
        "positive": ["7", 0],
        "negative": ["7", 1],
        "latent_image": ["7", 2]
      }
    },
    "10": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["9", 0],
        "vae": ["3", 0]
      }
    },
    "11": {
      "class_type": "SaveAnimatedWEBP",
      "inputs": {
        "filename_prefix": "promptforge_video",
        "fps": 24.0,
        "lossless": false,
        "quality": 85,
        "method": "default",
        "images": ["10", 0]
      }
    }
  }
}
