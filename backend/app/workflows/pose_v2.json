{
  "template": "pose",
  "version": 2,
  "task": "pose",
  "description": "Move a subject into a different pose WITHOUT losing the photograph. pose_v1 was a txt2img graph: it generated a fresh picture guided by a skeleton and threw the original away, which is why routing to it made every 'change the pose' request fail. This one repaints only the region the body occupies, so the background outside it is the original photograph's own pixels, and the identity comes from the face being composited back afterwards. ControlNet nodes (20-23) are OPTIONAL and are pruned when no reference pose is supplied - the sampler is then rewired to take conditioning straight from InpaintModelConditioning. DWPreprocessor MUST run with scale_stick_for_xinsr_cn enabled because the union ControlNet is xinsir's, and its bbox_detector MUST be the .torchscript.pt variant: onnxruntime here has no CUDA provider and the .onnx default runs on CPU.",
  "required_models": [
    "juggernaut-xl-inpaint",
    "controlnet-union-sdxl"
  ],
  "parameters": {
    "checkpoint": {"node": "1", "input": "ckpt_name"},
    "image": {"node": "2", "input": "image"},
    "mask": {"node": "3", "input": "image"},
    "prompt": {"node": "4", "input": "text"},
    "negative": {"node": "5", "input": "text"},
    "seed": {"node": "8", "input": "seed"},
    "steps": {"node": "8", "input": "steps"},
    "cfg": {"node": "8", "input": "cfg"},
    "denoise": {"node": "8", "input": "denoise"},
    "controlnet": {"node": "20", "input": "control_net_name"},
    "pose_reference": {"node": "21", "input": "image"},
    "strength": {"node": "23", "input": "strength"},
    "end_percent": {"node": "23", "input": "end_percent"},
    "filename_prefix": {"node": "10", "input": "filename_prefix"}
  },
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {"ckpt_name": "juggernautXL_inpaint.safetensors"}
    },
    "2": {
      "class_type": "LoadImage",
      "inputs": {"image": ""}
    },
    "3": {
      "class_type": "LoadImageMask",
      "inputs": {"image": "", "channel": "red"}
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {"text": "", "clip": ["1", 1]}
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {"text": "", "clip": ["1", 1]}
    },
    "6": {
      "class_type": "InpaintModelConditioning",
      "inputs": {
        "positive": ["4", 0],
        "negative": ["5", 0],
        "vae": ["1", 2],
        "pixels": ["2", 0],
        "mask": ["3", 0],
        "noise_mask": true
      }
    },
    "7": {
      "class_type": "DifferentialDiffusion",
      "inputs": {"model": ["1", 0]}
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 30,
        "cfg": 6.0,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 1.0,
        "model": ["7", 0],
        "positive": ["23", 0],
        "negative": ["23", 1],
        "latent_image": ["6", 2]
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": {"samples": ["8", 0], "vae": ["1", 2]}
    },
    "10": {
      "class_type": "SaveImage",
      "inputs": {"images": ["9", 0], "filename_prefix": "promptforge_pose"}
    },
    "20": {
      "class_type": "ControlNetLoader",
      "inputs": {"control_net_name": "controlnet_union_sdxl_promax.safetensors"}
    },
    "21": {
      "class_type": "LoadImage",
      "inputs": {"image": ""}
    },
    "22": {
      "class_type": "DWPreprocessor",
      "inputs": {
        "image": ["21", 0],
        "detect_hand": "enable",
        "detect_body": "enable",
        "detect_face": "enable",
        "resolution": 768,
        "bbox_detector": "yolox_l.torchscript.pt",
        "pose_estimator": "dw-ll_ucoco_384_bs5.torchscript.pt",
        "scale_stick_for_xinsr_cn": "enable"
      }
    },
    "23": {
      "class_type": "ControlNetApplyAdvanced",
      "inputs": {
        "positive": ["6", 0],
        "negative": ["6", 1],
        "control_net": ["20", 0],
        "image": ["22", 0],
        "strength": 0.85,
        "start_percent": 0.0,
        "end_percent": 0.85
      }
    }
  }
}
