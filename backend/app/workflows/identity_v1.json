{
  "template": "identity",
  "version": 1,
  "description": "Identity-preserving generation (PhotoMaker + SDXL, ComfyUI core nodes): renders the person from a reference face photo into any prompted scene. The positive text MUST contain the trigger word 'photomaker' right after the class word (e.g. 'photo of a person photomaker ...').",
  "required_models": [
    "sdxl-base",
    "photomaker-v1"
  ],
  "parameters": {
    "prompt": {
      "node": "4",
      "input": "text"
    },
    "negative": {
      "node": "5",
      "input": "text"
    },
    "image": {
      "node": "3",
      "input": "image"
    },
    "seed": {
      "node": "7",
      "input": "seed"
    },
    "steps": {
      "node": "7",
      "input": "steps"
    },
    "cfg": {
      "node": "7",
      "input": "cfg"
    },
    "width": {
      "node": "6",
      "input": "width"
    },
    "height": {
      "node": "6",
      "input": "height"
    }
  },
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_base_1.0.safetensors"
      }
    },
    "2": {
      "class_type": "PhotoMakerLoader",
      "inputs": {
        "photomaker_model_name": "photomaker-v1.bin"
      }
    },
    "3": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "4": {
      "class_type": "PhotoMakerEncode",
      "inputs": {
        "photomaker": ["2", 0],
        "image": ["3", 0],
        "clip": ["1", 1],
        "text": "photo of a person photomaker"
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "cartoon, painting, illustration, 3d render, blurry, deformed face, bad anatomy, extra fingers, watermark, text",
        "clip": ["1", 1]
      }
    },
    "6": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      }
    },
    "7": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 30,
        "cfg": 5.5,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 1.0,
        "model": ["1", 0],
        "positive": ["4", 0],
        "negative": ["5", 0],
        "latent_image": ["6", 0]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["7", 0],
        "vae": ["1", 2]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "promptforge_identity",
        "images": ["8", 0]
      }
    }
  }
}
