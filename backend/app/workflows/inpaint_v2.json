{
  "template": "inpaint",
  "version": 2,
  "description": "Quality-tuned SD inpainting: dpmpp_2m + karras, 34 steps, wider mask growth for seamless blends, stronger negative prompt. Slower than v1, visibly better edges.",
  "required_models": [
    "sd15-inpaint"
  ],
  "parameters": {
    "prompt": {
      "node": "6",
      "input": "text"
    },
    "negative_prompt": {
      "node": "7",
      "input": "text"
    },
    "image": {
      "node": "10",
      "input": "image"
    },
    "mask": {
      "node": "11",
      "input": "image"
    },
    "seed": {
      "node": "3",
      "input": "seed"
    },
    "steps": {
      "node": "3",
      "input": "steps"
    }
  },
  "graph": {
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 34,
        "cfg": 7.5,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 1.0,
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["12", 0]
      }
    },
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd-v1-5-inpainting.safetensors"
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": ["4", 1]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, jpeg artifacts, watermark, text, deformed, disfigured, bad anatomy, unrealistic, oversaturated, visible seam, halo",
        "clip": ["4", 1]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["3", 0],
        "vae": ["4", 2]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "promptforge",
        "images": ["8", 0]
      }
    },
    "10": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "11": {
      "class_type": "LoadImageMask",
      "inputs": {
        "image": "",
        "channel": "red"
      }
    },
    "12": {
      "class_type": "VAEEncodeForInpaint",
      "inputs": {
        "pixels": ["10", 0],
        "vae": ["4", 2],
        "mask": ["11", 0],
        "grow_mask_by": 16
      }
    }
  }
}
