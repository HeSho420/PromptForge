{
  "template": "angles",
  "version": 1,
  "description": "SV3D multi-view synthesis (ComfyUI native nodes): generates 21 orbital views of a subject from a single image, used to fill missing angles in an avatar dataset. 576x576, ~17deg per frame.",
  "required_models": [
    "sv3d"
  ],
  "parameters": {
    "image": {
      "node": "2",
      "input": "image"
    },
    "elevation": {
      "node": "3",
      "input": "elevation"
    },
    "frames": {
      "node": "3",
      "input": "video_frames"
    },
    "seed": {
      "node": "5",
      "input": "seed"
    },
    "steps": {
      "node": "5",
      "input": "steps"
    }
  },
  "graph": {
    "1": {
      "class_type": "ImageOnlyCheckpointLoader",
      "inputs": {
        "ckpt_name": "sv3d_u.safetensors"
      }
    },
    "2": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "3": {
      "class_type": "SV3D_Conditioning",
      "inputs": {
        "clip_vision": ["1", 1],
        "init_image": ["2", 0],
        "vae": ["1", 2],
        "width": 576,
        "height": 576,
        "video_frames": 21,
        "elevation": 0.0
      }
    },
    "4": {
      "class_type": "VideoLinearCFGGuidance",
      "inputs": {
        "model": ["1", 0],
        "min_cfg": 1.0
      }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 20,
        "cfg": 2.5,
        "sampler_name": "euler",
        "scheduler": "karras",
        "denoise": 1.0,
        "model": ["4", 0],
        "positive": ["3", 0],
        "negative": ["3", 1],
        "latent_image": ["3", 2]
      }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["5", 0],
        "vae": ["1", 2]
      }
    },
    "7": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "promptforge_angle",
        "images": ["6", 0]
      }
    }
  }
}
