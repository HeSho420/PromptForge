{
 "template": "identity_face",
 "version": 1,
 "task": "identity",
 "description": "InstantID: carry a person's face from ONE reference photo into a new SDXL render. Consent-gated in the pipeline, like every identity feature here. ApplyInstantID returns THREE outputs in order - model, positive, negative - and the sampler must take all three from it, not from the original checkpoint or the raw text encoders. weight ~0.8 is the usual balance; higher locks the face harder but flattens expression and pose. HEAVY but measured survivable on 8 GB VRAM / 15.7 GB RAM under ComfyUI 0.28's weight streaming (2026-08-24: 1024 render in 260 s, ArcFace likeness 0.781 vs PhotoMaker's 0.213 on the same prompt) - the registry gates now state that measured floor. Machines below it fall back to the PhotoMaker identity template, which is weaker but fits.",
 "required_models": [
  "sdxl-base",
  "instantid-ipadapter",
  "instantid-controlnet"
 ],
 "parameters": {
  "checkpoint": {
   "node": "1",
   "input": "ckpt_name"
  },
  "face": {
   "node": "5",
   "input": "image"
  },
  "prompt": {
   "node": "6",
   "input": "text"
  },
  "negative": {
   "node": "7",
   "input": "text"
  },
  "weight": {
   "node": "8",
   "input": "weight"
  },
  "width": {
   "node": "9",
   "input": "width"
  },
  "height": {
   "node": "9",
   "input": "height"
  },
  "seed": {
   "node": "10",
   "input": "seed"
  },
  "steps": {
   "node": "10",
   "input": "steps"
  },
  "cfg": {
   "node": "10",
   "input": "cfg"
  }
 },
 "graph": {
  "1": {
   "class_type": "CheckpointLoaderSimple",
   "inputs": {
    "ckpt_name": "sd_xl_base_1.0.safetensors"
   }
  },
  "2": {
   "class_type": "InstantIDModelLoader",
   "inputs": {
    "instantid_file": "ip-adapter.bin"
   }
  },
  "3": {
   "class_type": "InstantIDFaceAnalysis",
   "inputs": {
    "provider": "CPU"
   }
  },
  "4": {
   "class_type": "ControlNetLoader",
   "inputs": {
    "control_net_name": "instantid_controlnet.safetensors"
   }
  },
  "5": {
   "class_type": "LoadImage",
   "inputs": {
    "image": ""
   }
  },
  "6": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "",
    "clip": [
     "1",
     1
    ]
   }
  },
  "7": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "blurry, low quality, deformed, disfigured, bad anatomy, watermark, text",
    "clip": [
     "1",
     1
    ]
   }
  },
  "8": {
   "class_type": "ApplyInstantID",
   "inputs": {
    "instantid": [
     "2",
     0
    ],
    "insightface": [
     "3",
     0
    ],
    "control_net": [
     "4",
     0
    ],
    "image": [
     "5",
     0
    ],
    "model": [
     "1",
     0
    ],
    "positive": [
     "6",
     0
    ],
    "negative": [
     "7",
     0
    ],
    "weight": 0.8,
    "start_at": 0.0,
    "end_at": 1.0
   }
  },
  "9": {
   "class_type": "EmptyLatentImage",
   "inputs": {
    "width": 1024,
    "height": 1024,
    "batch_size": 1
   }
  },
  "10": {
   "class_type": "KSampler",
   "inputs": {
    "seed": 0,
    "steps": 26,
    "cfg": 5.0,
    "sampler_name": "dpmpp_2m",
    "scheduler": "karras",
    "denoise": 1.0,
    "model": [
     "8",
     0
    ],
    "positive": [
     "8",
     1
    ],
    "negative": [
     "8",
     2
    ],
    "latent_image": [
     "9",
     0
    ]
   }
  },
  "11": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": [
     "10",
     0
    ],
    "vae": [
     "1",
     2
    ]
   }
  },
  "12": {
   "class_type": "SaveImage",
   "inputs": {
    "filename_prefix": "promptforge_identity",
    "images": [
     "11",
     0
    ]
   }
  }
 }
}
