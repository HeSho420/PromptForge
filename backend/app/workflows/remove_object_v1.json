{
 "template": "remove_object",
 "version": 1,
 "task": "inpaint",
 "description": "Object removal: mask the object, the grown+feathered mask plus a background-continuation prompt makes it vanish seamlessly. Put a short description of the BACKGROUND (not the object) in the prompt slot. The decoded frame is composited back over the ORIGINAL pixels with the same feathered mask, so everything outside the removal region stays byte-identical (no whole-frame VAE softening).",
 "required_models": [
  "sd15-inpaint"
 ],
 "parameters": {
  "prompt": {
   "node": "6",
   "input": "text"
  },
  "image": {
   "node": "2",
   "input": "image"
  },
  "mask": {
   "node": "3",
   "input": "image"
  },
  "seed": {
   "node": "9",
   "input": "seed"
  }
 },
 "graph": {
  "1": {
   "class_type": "CheckpointLoaderSimple",
   "inputs": {
    "ckpt_name": "sd-v1-5-inpainting.safetensors"
   }
  },
  "2": {
   "class_type": "LoadImage",
   "inputs": {
    "image": ""
   }
  },
  "3": {
   "class_type": "LoadImageMask",
   "inputs": {
    "image": "",
    "channel": "red"
   }
  },
  "4": {
   "class_type": "GrowMask",
   "inputs": {
    "mask": [
     "3",
     0
    ],
    "expand": 16,
    "tapered_corners": true
   }
  },
  "5": {
   "class_type": "FeatherMask",
   "inputs": {
    "mask": [
     "4",
     0
    ],
    "left": 8,
    "top": 8,
    "right": 8,
    "bottom": 8
   }
  },
  "6": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "clean empty background, seamless continuation of the surroundings",
    "clip": [
     "1",
     1
    ]
   }
  },
  "7": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "object, person, artifact, seam, blurry, low quality, deformed, bad anatomy, watermark, text, jpeg artifacts",
    "clip": [
     "1",
     1
    ]
   }
  },
  "8": {
   "class_type": "VAEEncodeForInpaint",
   "inputs": {
    "pixels": [
     "2",
     0
    ],
    "vae": [
     "1",
     2
    ],
    "mask": [
     "5",
     0
    ],
    "grow_mask_by": 6
   }
  },
  "9": {
   "class_type": "KSampler",
   "inputs": {
    "seed": 0,
    "steps": 34,
    "cfg": 7.0,
    "sampler_name": "dpmpp_2m",
    "scheduler": "karras",
    "denoise": 1.0,
    "model": [
     "1",
     0
    ],
    "positive": [
     "6",
     0
    ],
    "negative": [
     "7",
     0
    ],
    "latent_image": [
     "8",
     0
    ]
   }
  },
  "10": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": [
     "9",
     0
    ],
    "vae": [
     "1",
     2
    ]
   }
  },
  "11": {
   "class_type": "SaveImage",
   "inputs": {
    "filename_prefix": "promptforge_inpaint",
    "images": [
     "12",
     0
    ]
   }
  },
  "12": {
   "class_type": "ImageCompositeMasked",
   "inputs": {
    "destination": [
     "2",
     0
    ],
    "source": [
     "10",
     0
    ],
    "x": 0,
    "y": 0,
    "resize_source": false,
    "mask": [
     "5",
     0
    ]
   }
  }
 }
}