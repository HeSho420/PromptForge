{
 "template": "img2img",
 "version": 2,
 "task": "img2img",
 "description": "Standard img2img: re-render an uploaded image with a new prompt. denoise 0.6 keeps composition; raise towards 0.8 for bigger changes. The checkpoint and cfg are swappable so the adherence ladder can change MODEL or sampler strength when a render did not do what the prompt asked.",
 "required_models": [],
 "parameters": {
  "checkpoint": {
   "node": "1",
   "input": "ckpt_name"
  },
  "prompt": {
   "node": "3",
   "input": "text"
  },
  "negative": {
   "node": "4",
   "input": "text"
  },
  "image": {
   "node": "2",
   "input": "image"
  },
  "seed": {
   "node": "6",
   "input": "seed"
  },
  "denoise": {
   "node": "6",
   "input": "denoise"
  },
  "steps": {
   "node": "6",
   "input": "steps"
  },
  "cfg": {
   "node": "6",
   "input": "cfg"
  }
 },
 "graph": {
  "1": {
   "class_type": "CheckpointLoaderSimple",
   "inputs": {
    "ckpt_name": "sd-v1-5-inpainting.safetensors"
   }
  },
  "2": {
   "class_type": "LoadImage",
   "inputs": {
    "image": ""
   }
  },
  "3": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "",
    "clip": [
     "1",
     1
    ]
   }
  },
  "4": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "blurry, low quality, deformed, bad anatomy, watermark, text, jpeg artifacts",
    "clip": [
     "1",
     1
    ]
   }
  },
  "5": {
   "class_type": "VAEEncode",
   "inputs": {
    "pixels": [
     "2",
     0
    ],
    "vae": [
     "1",
     2
    ]
   }
  },
  "6": {
   "class_type": "KSampler",
   "inputs": {
    "seed": 0,
    "steps": 30,
    "cfg": 7.0,
    "sampler_name": "dpmpp_2m",
    "scheduler": "karras",
    "denoise": 0.6,
    "model": [
     "1",
     0
    ],
    "positive": [
     "3",
     0
    ],
    "negative": [
     "4",
     0
    ],
    "latent_image": [
     "5",
     0
    ]
   }
  },
  "7": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": [
     "6",
     0
    ],
    "vae": [
     "1",
     2
    ]
   }
  },
  "8": {
   "class_type": "SaveImage",
   "inputs": {
    "filename_prefix": "promptforge",
    "images": [
     "7",
     0
    ]
   }
  }
 }
}
