{
 "template": "identity_face_restore",
 "version": 1,
 "task": "identity",
 "description": "Identity-conditioned face restore: re-renders a FACE CROP at full resolution with the persona's InstantID conditioning, so a small face (a head-to-toe render leaves ~128px for it) gets real detail WITHOUT losing the likeness - the naive FaceDetailer, which has no identity conditioning, was measured sharpening a persona's face out of her likeness (0.84 -> 0.62) and was removed. img2img from the crop's own latent at ~0.5 denoise; image_kps is the crop itself so the face stays exactly where it is. The handler pastes the result back with a feathered mask and keeps it ONLY if the measured likeness improves.",
 "required_models": [
  "sdxl-base",
  "instantid-ipadapter",
  "instantid-controlnet"
 ],
 "parameters": {
  "checkpoint": {
   "node": "1",
   "input": "ckpt_name"
  },
  "crop": {
   "node": "2",
   "input": "image"
  },
  "face": {
   "node": "3",
   "input": "image"
  },
  "prompt": {
   "node": "7",
   "input": "text"
  },
  "seed": {
   "node": "11",
   "input": "seed"
  },
  "denoise": {
   "node": "11",
   "input": "denoise"
  },
  "weight": {
   "node": "9",
   "input": "weight"
  }
 },
 "graph": {
