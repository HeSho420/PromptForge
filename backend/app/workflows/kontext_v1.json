{
  "template": "kontext",
  "version": 1,
  "task": "kontext",
  "description": "Instruction-based editing with FLUX.1 Kontext (12B, Q4 GGUF): give it the image and a plain instruction ('remove the hat', 'make it night') and it edits the whole picture coherently WITHOUT a mask, keeping everything else. Rendered at about 1 megapixel, which is the size it was trained on and 3x faster than native. Requires the 'gguf' node pack (Models tab) + the flux-kontext-q4 model.",
  "required_models": [
    "flux-kontext-q4",
    "flux-t5-fp8",
    "flux-clip-l",
    "flux-ae"
  ],
