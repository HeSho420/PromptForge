{
  "template": "background_guided",
  "version": 1,
  "task": "background",
  "description": "Background replacement pinned to the photograph's MEASURED perspective. Identical to the background template (BiRefNet inverted matte, soft inpaint, composite-back, bgplate export) plus a depth ControlNet whose control image is SYNTHESIZED from the scene probe: the subject keeps its measured depth, the ground keeps its measured disparity ramp extended to the measured horizon, everything above the horizon is left far/free. Words alone held the measured horizon on about half the draws - the conditioning is the adherence lever. end_percent 0.8 releases the last fifth of sampling so fine detail is not fighting the coarse guidance.",
  "required_models": [
    "sd15-inpaint",
    "controlnet-sd15-depth"
  ],
  "parameters": {
    "checkpoint": {
      "node": "1",
      "input": "ckpt_name"
    },
    "image": {
      "node": "2",
      "input": "image"
    },
    "rmbg_model": {
      "node": "3",
      "input": "model"
    },
    "prompt": {
      "node": "7",
      "input": "text"
    },
    "negative": {
      "node": "8",
      "input": "text"
    },
    "seed": {
      "node": "11",
      "input": "seed"
    },
    "steps": {
      "node": "11",
      "input": "steps"
    },
    "cfg": {
      "node": "11",
      "input": "cfg"
    },
    "control_image": {
      "node": "21",
      "input": "image"
    },
    "control_strength": {
      "node": "22",
      "input": "strength"
    }
  },
  "graph": {
