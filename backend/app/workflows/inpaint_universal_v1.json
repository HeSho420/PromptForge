{
  "template": "inpaint_universal",
  "version": 1,
  "task": "inpaint",
  "description": "Universal inpainting via SetLatentNoiseMask: works with ANY checkpoint (no dedicated inpaint model needed), so the LLM can inpaint with photoreal community models. denoise <1.0 keeps composition from the original pixels.",
  "required_models": [],
  "parameters": {
    "checkpoint": {
      "node": "1",
      "input": "ckpt_name"
    },
    "image": {
      "node": "2",
      "input": "image"
    },
    "mask": {
      "node": "3",
      "input": "image"
    },
    "prompt": {
      "node": "6",
      "input": "text"
    },
    "negative": {
      "node": "7",
      "input": "text"
    },
    "denoise": {
      "node": "10",
      "input": "denoise"
    },
    "seed": {
      "node": "10",
      "input": "seed"
    },
    "steps": {
      "node": "10",
      "input": "steps"
    }
  },
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_base_1.0.safetensors"
      }
    },
    "2": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "3": {
      "class_type": "LoadImageMask",
      "inputs": {
        "image": "",
        "channel": "red"
      }
    },
    "4": {
      "class_type": "GrowMask",
      "inputs": {
        "mask": [
          "3",
          0
        ],
        "expand": 12,
        "tapered_corners": true
      }
    },
    "5": {
      "class_type": "FeatherMask",
      "inputs": {
        "mask": [
          "4",
          0
        ],
        "left": 8,
        "top": 8,
        "right": 8,
        "bottom": 8
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": [
          "1",
          1
        ]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, jpeg artifacts, watermark, text, deformed, disfigured, bad anatomy, unrealistic, oversaturated, visible seam, halo",
        "clip": [
          "1",
          1
        ]
      }
    },
    "8": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "2",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "9": {
      "class_type": "SetLatentNoiseMask",
      "inputs": {
        "samples": [
          "8",
          0
        ],
        "mask": [
          "5",
          0
        ]
      }
    },
    "10": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 30,
        "cfg": 7.0,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 0.85,
        "model": [
          "1",
          0
        ],
        "positive": [
          "6",
          0
        ],
        "negative": [
          "7",
          0
        ],
        "latent_image": [
          "9",
          0
        ]
      }
    },
    "11": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "12": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "promptforge",
        "images": [
          "11",
          0
        ]
      }
    }
  }
}