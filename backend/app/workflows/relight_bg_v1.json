{
  "template": "relight_bg",
  "version": 1,
  "task": "relight",
  "description": "Relight a subject to match the scene BEHIND it. IC-Light FBC is the background-conditioned variant: it takes the cut-out subject as the foreground latent and the new background as opt_background, so the light direction, colour temperature and intensity come from the actual scene rather than from a text description. This is what stops a replaced background looking pasted on. The checkpoint MUST be a 4-channel SD1.5 base - a 9-channel inpainting checkpoint raises 'new shape must be larger' when the IC-Light patch is applied.",
  "required_models": [
    "iclight-sd15-fbc",
    "sd15-base"
  ],
  "parameters": {
    "checkpoint": {
      "node": "1",
      "input": "ckpt_name"
    },
    "image": {
      "node": "2",
      "input": "image"
    },
    "background": {
      "node": "3",
      "input": "image"
    },
    "rmbg_model": {
      "node": "4",
      "input": "model"
    },
    "prompt": {
      "node": "6",
      "input": "text"
    },
    "negative": {
      "node": "7",
      "input": "text"
    },
    "seed": {
      "node": "11",
      "input": "seed"
    },
    "steps": {
      "node": "11",
      "input": "steps"
    },
    "cfg": {
      "node": "11",
      "input": "cfg"
    },
    "denoise": {
      "node": "11",
      "input": "denoise"
    }
  },
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "v1-5-pruned-emaonly.safetensors"
      }
    },
    "2": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "3": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "4": {
      "class_type": "BiRefNetRMBG",
      "inputs": {
        "image": [
          "2",
          0
        ],
        "model": "BiRefNet-portrait",
        "sensitivity": 1.0,
        "mask_blur": 4,
        "mask_offset": 0,
        "invert_output": false,
        "refine_foreground": true,
        "background": "Color",
        "background_color": "#7F7F7F"
      }
    },
    "5": {
      "class_type": "LoadAndApplyICLightUnet",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "model_path": "iclight_sd15_fbc.safetensors"
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": [
          "1",
          1
        ]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "lowres, bad anatomy, watermark, text, jpeg artifacts, blurry, oversaturated, flat lighting, studio flash, cut out, pasted, sticker edge, rim outline, mismatched lighting",
        "clip": [
          "1",
          1
        ]
      }
    },
    "8": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "4",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "9": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "3",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "10": {
      "class_type": "ICLightConditioning",
      "inputs": {
        "positive": [
          "6",
          0
        ],
        "negative": [
          "7",
          0
        ],
        "vae": [
          "1",
          2
        ],
        "foreground": [
          "8",
          0
        ],
        "multiplier": 0.18215,
        "opt_background": [
          "9",
          0
        ]
      }
    },
    "11": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 25,
        "cfg": 2.05,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 0.9,
        "model": [
          "5",
          0
        ],
        "positive": [
          "10",
          0
        ],
        "negative": [
          "10",
          1
        ],
        "latent_image": [
          "10",
          2
        ]
      }
    },
    "12": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "11",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "13": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "promptforge_relit",
        "images": [
          "12",
          0
        ]
      }
    }
  }
}
