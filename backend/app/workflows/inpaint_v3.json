{
  "template": "inpaint",
  "version": 3,
  "task": "inpaint",
  "description": "Modern soft inpainting: InpaintModelConditioning + DifferentialDiffusion (per-pixel denoise strength = seamless blends), grown+feathered mask, dpmpp_2m/karras. Checkpoint is swappable so the LLM can pick the model.",
  "required_models": [
    "sd15-inpaint"
  ],
  "parameters": {
    "checkpoint": {
      "node": "1",
      "input": "ckpt_name"
    },
    "image": {
      "node": "2",
      "input": "image"
    },
    "mask": {
      "node": "3",
      "input": "image"
    },
    "prompt": {
      "node": "6",
      "input": "text"
    },
    "negative": {
      "node": "7",
      "input": "text"
    },
    "seed": {
      "node": "10",
      "input": "seed"
    },
    "steps": {
      "node": "10",
      "input": "steps"
    }
  },
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd-v1-5-inpainting.safetensors"
      }
    },
    "2": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "3": {
      "class_type": "LoadImageMask",
      "inputs": {
        "image": "",
        "channel": "red"
      }
    },
    "4": {
      "class_type": "GrowMask",
      "inputs": {
        "mask": [
          "3",
          0
        ],
        "expand": 12,
        "tapered_corners": true
      }
    },
    "5": {
      "class_type": "FeatherMask",
      "inputs": {
        "mask": [
          "4",
          0
        ],
        "left": 8,
        "top": 8,
        "right": 8,
        "bottom": 8
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": [
          "1",
          1
        ]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, jpeg artifacts, watermark, text, deformed, disfigured, bad anatomy, extra limbs, extra fingers, mutated hands, malformed limbs, poorly drawn face, poorly drawn hands, unrealistic, oversaturated, visible seam, halo",
        "clip": [
          "1",
          1
        ]
      }
    },
    "8": {
      "class_type": "InpaintModelConditioning",
      "inputs": {
        "positive": [
          "6",
          0
        ],
        "negative": [
          "7",
          0
        ],
        "vae": [
          "1",
          2
        ],
        "pixels": [
          "2",
          0
        ],
        "mask": [
          "5",
          0
        ],
        "noise_mask": true
      }
    },
    "9": {
      "class_type": "DifferentialDiffusion",
      "inputs": {
        "model": [
          "1",
          0
        ]
      }
    },
    "10": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 34,
        "cfg": 6.5,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 1.0,
        "model": [
          "9",
          0
        ],
        "positive": [
          "8",
          0
        ],
        "negative": [
          "8",
          1
        ],
        "latent_image": [
          "8",
          2
        ]
      }
    },
    "11": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "12": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "promptforge",
        "images": [
          "11",
          0
        ]
      }
    }
  }
}