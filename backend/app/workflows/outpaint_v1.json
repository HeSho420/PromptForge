     "2",
     0
    ],
    "left": 192,
    "top": 0,
    "right": 192,
    "bottom": 0,
    "feathering": 40
   }
  },
  "4": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "",
    "clip": [
     "1",
     1
    ]
   }
  },
  "5": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "frame, border, seam, blurry, low quality, deformed, bad anatomy, watermark, text, jpeg artifacts",
    "clip": [
     "1",
     1
    ]
   }
  },
  "6": {
   "class_type": "VAEEncodeForInpaint",
   "inputs": {
    "pixels": [
     "3",
     0
    ],
    "vae": [
     "1",
     2
    ],
    "mask": [
