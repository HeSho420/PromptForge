{
 "template": "outpaint",
 "version": 1,
 "task": "outpaint",
 "description": "Outpainting: extends the canvas (default 192 px left+right) and paints the new area to continue the scene. Describe the WHOLE scene in the prompt. Adjust left/top/right/bottom on the ImagePadForOutpaint node for other directions.",
 "required_models": [
  "sd15-inpaint"
 ],
 "parameters": {
  "prompt": {
   "node": "4",
   "input": "text"
  },
  "negative": {
   "node": "5",
   "input": "text"
  },
  "image": {
   "node": "2",
   "input": "image"
  },
  "seed": {
   "node": "7",
   "input": "seed"
  },
  "left": {
   "node": "3",
   "input": "left"
  },
  "right": {
   "node": "3",
   "input": "right"
  },
  "top": {
   "node": "3",
   "input": "top"
  },
  "bottom": {
   "node": "3",
   "input": "bottom"
  }
 },
 "graph": {
