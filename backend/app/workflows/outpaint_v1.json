   "inputs": {
    "seed": 0,
    "steps": 34,
    "cfg": 7.0,
    "sampler_name": "dpmpp_2m",
    "scheduler": "karras",
    "denoise": 1.0,
    "model": [
     "1",
     0
    ],
    "positive": [
     "4",
     0
    ],
    "negative": [
     "5",
     0
    ],
    "latent_image": [
     "6",
     0
    ]
   }
  },
  "8": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": [
     "7",
     0
    ],
    "vae": [
     "1",
     2
    ]
   }
  },
  "9": {
   "class_type": "SaveImage",
   "inputs": {
    "filename_prefix": "promptforge_outpaint",
