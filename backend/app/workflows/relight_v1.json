{
 "template": "relight",
 "version": 1,
 "task": "relight",
 "description": "IC-Light (fc) relighting: re-lights an uploaded photo while keeping the subject. The prompt must describe LIGHTING ONLY ('warm golden hour sunlight from the left, soft rim light') - if it describes a subject, IC-Light re-synthesises that subject instead of relighting the photo. The subject is held by IC-Light's foreground latent concat, NOT by the start latent (ICLightConditioning emits a ZERO latent), so denoise must stay high: 0.9 is the node author's reference value and anything below ~0.8 collapses to flat grey. Requires an SD1.5 base checkpoint with a 4-channel UNet - SD1.5 *inpainting* checkpoints are 9-channel, cannot be patched, and fail inside KSampler with 'The new shape must be larger than the original tensor in all dimensions'.",
 "required_models": [
  "iclight-sd15-fc",
  "sd15-base"
 ],
 "parameters": {
  "checkpoint": {
   "node": "1",
   "input": "ckpt_name"
  },
  "prompt": {
   "node": "4",
   "input": "text"
  },
  "negative": {
   "node": "5",
   "input": "text"
  },
  "image": {
   "node": "2",
   "input": "image"
  },
  "seed": {
   "node": "8",
   "input": "seed"
  },
  "steps": {
   "node": "8",
   "input": "steps"
  },
  "cfg": {
   "node": "8",
   "input": "cfg"
  }
 },
 "graph": {
  "1": {
   "class_type": "CheckpointLoaderSimple",
   "inputs": {
    "ckpt_name": "v1-5-pruned-emaonly.safetensors"
   }
  },
  "2": {
   "class_type": "LoadImage",
   "inputs": {
    "image": ""
   }
  },
  "3": {
   "class_type": "LoadAndApplyICLightUnet",
   "inputs": {
    "model": [
     "1",
     0
    ],
    "model_path": "iclight_sd15_fc.safetensors"
   }
  },
  "4": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "",
    "clip": [
     "1",
     1
    ]
   }
  },
  "5": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "lowres, bad anatomy, watermark, text, jpeg artifacts, blurry, oversaturated, flat lighting",
    "clip": [
     "1",
     1
    ]
   }
  },
  "6": {
   "class_type": "VAEEncode",
   "inputs": {
    "pixels": [
     "2",
     0
    ],
    "vae": [
     "1",
     2
    ]
   }
  },
  "7": {
   "class_type": "ICLightConditioning",
   "inputs": {
    "positive": [
     "4",
     0
    ],
    "negative": [
     "5",
     0
    ],
    "vae": [
     "1",
     2
    ],
    "foreground": [
     "6",
     0
    ],
    "multiplier": 0.18215
   }
  },
  "8": {
   "class_type": "KSampler",
   "inputs": {
    "seed": 0,
    "steps": 25,
    "cfg": 2.05,
    "sampler_name": "dpmpp_2m",
    "scheduler": "karras",
    "denoise": 0.9,
    "model": [
     "3",
     0
    ],
    "positive": [
     "7",
     0
    ],
    "negative": [
     "7",
     1
    ],
    "latent_image": [
     "7",
     2
    ]
   }
  },
  "9": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": [
     "8",
     0
    ],
    "vae": [
     "1",
     2
    ]
   }
  },
  "10": {
   "class_type": "SaveImage",
   "inputs": {
    "filename_prefix": "promptforge_relight",
    "images": [
     "9",
     0
    ]
   }
  }
 }
}
