{
  "template": "background",
  "version": 1,
  "task": "background",
  "description": "Background replacement that cannot touch the subject. BiRefNet cuts an exact subject matte; the INVERTED matte is what gets repainted, so only the background is sampled. The original subject pixels are then composited back over the result through a slightly eroded copy of the same matte - so the subject's interior is literally the input pixels and only the rim is blended. Softening comes from BiRefNet's own mask_blur, NOT from FeatherMask: FeatherMask tapers all four IMAGE borders too, which left the outermost pixels unrepainted (a visible frame around the new scene) and blended generated content into the subject where it touches the bottom edge. Soft inpainting (InpaintModelConditioning + DifferentialDiffusion) keeps the new scene seamless at the subject boundary. A second SaveImage exports the pre-composite decode: that frame is the new scene with NO subject in it, which is what the relight pass needs to read the light from (handing it the composite makes it read the subject's own colours back as ambient).",
  "required_models": [
    "sd15-inpaint"
  ],
  "parameters": {
    "checkpoint": {
      "node": "1",
      "input": "ckpt_name"
    },
    "image": {
      "node": "2",
      "input": "image"
    },
    "rmbg_model": {
      "node": "3",
      "input": "model"
    },
    "prompt": {
      "node": "7",
      "input": "text"
    },
    "negative": {
      "node": "8",
      "input": "text"
    },
    "seed": {
      "node": "11",
      "input": "seed"
    },
    "steps": {
      "node": "11",
      "input": "steps"
    },
    "cfg": {
      "node": "11",
      "input": "cfg"
    }
  },
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd-v1-5-inpainting.safetensors"
      }
    },
    "2": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "3": {
      "class_type": "BiRefNetRMBG",
      "inputs": {
        "image": [
          "2",
          0
        ],
        "model": "BiRefNet-portrait",
        "sensitivity": 1.0,
        "mask_blur": 4,
        "mask_offset": 0,
        "invert_output": false,
        "refine_foreground": true,
        "background": "Alpha",
        "background_color": "#222222"
      }
    },
    "4": {
      "class_type": "InvertMask",
      "inputs": {
        "mask": [
          "3",
          1
        ]
      }
    },
    "5": {
      "class_type": "GrowMask",
      "inputs": {
        "mask": [
          "4",
          0
        ],
        "expand": 3,
        "tapered_corners": true
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": [
          "1",
          1
        ]
      }
    },
    "8": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "picture frame, framed picture, poster, wall art, painting on a wall, photograph of a photograph, screen, monitor, mirror, window frame, border, matte border, vignette, blurry, low quality, jpeg artifacts, watermark, text, deformed, cut off, visible seam, halo, outline, sticker edge, pasted cutout, floating subject, duplicate person, extra limbs",
        "clip": [
          "1",
          1
        ]
      }
    },
    "9": {
      "class_type": "InpaintModelConditioning",
      "inputs": {
        "positive": [
          "7",
          0
        ],
        "negative": [
          "8",
          0
        ],
        "vae": [
          "1",
          2
        ],
        "pixels": [
          "2",
          0
        ],
        "mask": [
          "5",
          0
        ],
        "noise_mask": true
      }
    },
    "10": {
      "class_type": "DifferentialDiffusion",
      "inputs": {
        "model": [
          "1",
          0
        ]
      }
    },
    "11": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 34,
        "cfg": 6.5,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "denoise": 1.0,
        "model": [
          "10",
          0
        ],
        "positive": [
          "9",
          0
        ],
        "negative": [
          "9",
          1
        ],
        "latent_image": [
          "9",
          2
        ]
      }
    },
    "12": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "11",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "13": {
      "class_type": "GrowMask",
      "inputs": {
        "mask": [
          "3",
          1
        ],
        "expand": -2,
        "tapered_corners": true
      }
    },
    "15": {
      "class_type": "ImageCompositeMasked",
      "inputs": {
        "destination": [
          "12",
          0
        ],
        "source": [
          "2",
          0
        ],
        "x": 0,
        "y": 0,
        "resize_source": false,
        "mask": [
          "13",
          0
        ]
      }
    },
    "16": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "promptforge_background",
        "images": [
          "15",
          0
        ]
      }
    },
    "17": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "promptforge_bgplate",
        "images": [
          "12",
          0
        ]
      }
    }
  }
}
