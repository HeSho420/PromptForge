{
  "template": "reconstruct",
  "version": 1,
  "task": "reconstruct",
  "description": "One photo to a real 3D mesh, exported as GLB. Uses ComfyUI's built-in Hunyuan3D v2 support - no custom node pack, nothing to compile. ImageOnlyCheckpointLoader supplies MODEL + CLIP_VISION + VAE from a single repackaged file, which matters because CLIPVisionLoader has no standalone model on this machine. The output is SHAPE ONLY: ComfyUI has no Hunyuan3D texture-paint stage, so the mesh is untextured. Texturing needs ~12 GB VRAM and is gated behind the hardware tier check. ModelSamplingAuraFlow and FluxGuidance are NOT optional: without the AuraFlow sampling patch the DiT gets no positional embeddings and KSampler dies with \"'NoneType' object has no attribute 'dtype'\" - copied from ComfyUI's own shipped template after hitting exactly that.",
  "required_models": [
    "hunyuan3d-v2"
  ],
  "parameters": {
    "checkpoint": {
      "node": "1",
      "input": "ckpt_name"
    },
    "image": {
      "node": "2",
      "input": "image"
    },
    "resolution": {
      "node": "5",
      "input": "resolution"
    },
    "seed": {
      "node": "6",
      "input": "seed"
    },
    "steps": {
      "node": "6",
      "input": "steps"
    },
    "cfg": {
      "node": "6",
      "input": "cfg"
    },
    "octree_resolution": {
      "node": "7",
      "input": "octree_resolution"
    },
    "num_chunks": {
      "node": "7",
      "input": "num_chunks"
    },
    "threshold": {
      "node": "8",
      "input": "threshold"
    },
    "filename_prefix": {
      "node": "9",
      "input": "filename_prefix"
    },
    "guidance": {
      "node": "91",
      "input": "guidance"
    },
    "shift": {
      "node": "90",
      "input": "shift"
    }
  },
  "graph": {
    "1": {
      "class_type": "ImageOnlyCheckpointLoader",
      "inputs": {
        "ckpt_name": "hunyuan3d-dit-v2_fp16.safetensors"
      }
    },
    "2": {
      "class_type": "LoadImage",
      "inputs": {
        "image": ""
      }
    },
    "3": {
      "class_type": "CLIPVisionEncode",
      "inputs": {
        "clip_vision": [
          "1",
          1
        ],
        "image": [
          "2",
          0
        ],
        "crop": "center"
      }
    },
    "4": {
      "class_type": "Hunyuan3Dv2Conditioning",
      "inputs": {
        "clip_vision_output": [
          "3",
          0
        ]
      }
    },
    "5": {
      "class_type": "EmptyLatentHunyuan3Dv2",
      "inputs": {
        "resolution": 3072,
        "batch_size": 1
      }
    },
    "6": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 30,
        "cfg": 4.0,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1.0,
        "model": [
          "90",
          0
        ],
        "positive": [
          "91",
          0
        ],
        "negative": [
          "4",
          1
        ],
        "latent_image": [
          "5",
          0
        ]
      }
    },
    "7": {
      "class_type": "VAEDecodeHunyuan3D",
      "inputs": {
        "samples": [
          "6",
          0
        ],
        "vae": [
          "1",
          2
        ],
        "num_chunks": 8000,
        "octree_resolution": 256
      }
    },
    "8": {
      "class_type": "VoxelToMesh",
      "inputs": {
        "voxel": [
          "7",
          0
        ],
        "algorithm": "surface net",
        "threshold": 0.6
      }
    },
    "9": {
      "class_type": "SaveGLB",
      "inputs": {
        "mesh": [
          "8",
          0
        ],
        "filename_prefix": "promptforge_mesh"
      }
    },
    "90": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "shift": 1.0
      }
    },
    "91": {
      "class_type": "FluxGuidance",
      "inputs": {
        "conditioning": [
          "4",
          0
        ],
        "guidance": 3.5
      }
    }
  }
}
