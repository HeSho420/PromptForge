{
 "template": "portrait",
 "version": 2,
 "task": "generate",
 "description": "Portrait-tuned SD1.5 generation: 2:3 canvas, prompt scaffold for skin texture and lighting. Append the subject description to the prompt slot. The checkpoint and cfg are swappable so the adherence ladder can change MODEL or guidance strength when a render did not do what the prompt asked.",
 "required_models": [],
 "parameters": {
  "checkpoint": {
   "node": "1",
   "input": "ckpt_name"
  },
  "prompt": {
   "node": "2",
   "input": "text"
  },
  "negative": {
   "node": "3",
   "input": "text"
  },
  "seed": {
   "node": "5",
   "input": "seed"
  },
  "steps": {
   "node": "5",
   "input": "steps"
  },
  "cfg": {
   "node": "5",
   "input": "cfg"
  }
 },
 "graph": {
  "1": {
   "class_type": "CheckpointLoaderSimple",
   "inputs": {
    "ckpt_name": "sd-v1-5-inpainting.safetensors"
   }
  },
  "2": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "RAW photo, 85mm portrait, natural skin texture, soft light, shallow depth of field",
    "clip": [
     "1",
     1
    ]
   }
  },
  "3": {
   "class_type": "CLIPTextEncode",
   "inputs": {
    "text": "cartoon, 3d render, doll, waxy skin, blurry, low quality, deformed, bad anatomy, watermark, text, jpeg artifacts",
    "clip": [
     "1",
     1
    ]
   }
  },
  "4": {
   "class_type": "EmptyLatentImage",
   "inputs": {
    "width": 640,
    "height": 960,
    "batch_size": 1
   }
  },
  "5": {
   "class_type": "KSampler",
   "inputs": {
    "seed": 0,
    "steps": 32,
    "cfg": 6.5,
    "sampler_name": "dpmpp_2m",
    "scheduler": "karras",
    "denoise": 1.0,
    "model": [
     "1",
     0
    ],
    "positive": [
     "2",
     0
    ],
    "negative": [
     "3",
     0
    ],
    "latent_image": [
     "4",
     0
    ]
   }
  },
  "6": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": [
     "5",
     0
    ],
    "vae": [
     "1",
     2
    ]
   }
  },
  "7": {
   "class_type": "SaveImage",
   "inputs": {
    "filename_prefix": "promptforge",
    "images": [
     "6",
     0
    ]
   }
  }
 }
}
